 },
 "content": {
  "rendered": "<section class=\"bde-section-1649-100 bde-section\">\n              \n  \n  \n\t\n\n  <div class=\"section-background-overlay\"></div>\n\n\n<div class=\"section-container\"><div class=\"bde-shortcode-1649-117 bde-shortcode\"><nav class=\"breadcrumbs\" aria-label=\"Breadcrumbs\"><a href=\"https://neofollicletransplant.com/\" class=\"breadcrumb breadcrumb--first\">Home</a> <span class='breadcrumbs__separator' aria-hidden='true'>&raquo;</span> <span class=\"breadcrumb breadcrumb--last\" aria-current=\"page\"></span></nav></div><h1 class=\"bde-heading-1649-101 bde-heading\">\nContact Us\n</h1></div>\n</section><section class=\"bde-section-1649-102 bde-section\">\n  \n  \n\t\n\n\n\n<div class=\"section-container\"><h2 class=\"bde-heading-1649-104 bde-heading\">\nBook Your Appointment\n</h2><div class=\"bde-text-1649-105 bde-text\">\nNeo Follicle Transplant Clinic is a hair transplant and hair loss treatment clinic in Bangalore, founded and led by Dr. Sandeep Mahapatra, Senior Dermatologist and Hair Transplant Surgeon, offering advanced hair transplant procedures and non-surgical hair restoration treatments for men, women, celebrities, and international patients.\n</div><div class=\"bde-text-1649-111 bde-text\">\nYou can click the below buttons to call or WhatsApp the appointment desk to book your visit.\n</div><div class=\"bde-columns-1649-106 bde-columns\"><div class=\"bde-column-1649-107 bde-column\">\n  \n  \n\t\n\n\n\n<div class=\"bde-text-1649-113 bde-text\">\n<b>Click the below button to Call.</b>\n</div><div class=\"bde-globalblock-1649-112 bde-globalblock\"><div class=\"bde-button-77-100-77-1 bde-button bde-button-77-100\">\n        \n    \n    \n    \n    \n            \n                    \n            \n            \n\n    \n    \n    \n    \n    \n    <a class=\"breakdance-link button-atom button-atom--custom bde-button__button\" href=\"tel:+919731207940\" target=\"_self\" data-type=\"url\"  >\n\n    \n        <span class=\"button-atom__text\">Call # +91 - 97312 07940</span>\n\n                            \n        \n                </a>\n\n    \n\n\n</div></div>\n</div><div class=\"bde-column-1649-108 bde-column\">\n  \n  \n\t\n\n\n\n<div class=\"bde-text-1649-114 bde-text\">\n<b>Click the below button to Whatsapp</b>\n</div><div class=\"bde-button-1649-110 bde-button\">\n        \n    \n    \n    \n    \n            \n            <button type=\"button\" class=\"button-atom button-atom--custom bde-button__button\"  >\n    \n        <span class=\"button-atom__text\">Whatsapp for Appointment</span>\n\n                            \n        \n            </button>\n    \n\n\n</div>\n</div></div><div class=\"bde-text-1649-116 bde-text\">\n<b>Clinic Address:</b> 1st floor, Scorpio House, Near Marathahalli Bridge Munnekoala, Near Marathahalli Bridge Service Rd, Opp. Purvankara Apt, Opposite to Purva Apartments, Bengaluru, Karnataka 560037\n</div><div class=\"bde-google-map-1649-115 bde-google-map\">\n<iframe width=\"100%\" height=\"100%\" style=\"border:0\" loading=\"lazy\" title=\"Map\" src=\"https://maps.google.com/maps?q=Neo+Follicle+Hairt+Transplant+Clinic%2C%3Cbr%3E1st+floor%2C+Scorpio+House%2C%3Cbr%3ENear+Marathahalli+Bridge+Munnekoala%2C+Near+Marathahalli+Bridge+Service+Rd%2C+Opp.+Purvankara+Apt%2C%3Cbr%3EOpposite+to+Purva+Apartments%2C+Bengaluru%2C+Karnataka+560037&t=m&z=14&output=embed&iwloc=near\" allowfullscreen></iframe>\n</div></div>\n</section>",
