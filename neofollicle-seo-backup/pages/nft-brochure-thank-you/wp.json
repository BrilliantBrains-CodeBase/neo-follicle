 "content": {
  "rendered": "<section class=\"bde-section-1164-100 bde-section\">\n  \n  \n\t\n\n\n\n<div class=\"section-container\"><img decoding=\"async\" class=\"bde-image2-1164-101 bde-image2\" src=\"https://neofollicletransplant.com/wp-content/uploads/2025/03/NFT-Logo-svg.svg\" alt=\"Neo Follicle Transplant Logo\" loading=\"lazy\" sizes=\"(max-width: 200px) 100vw, 200px\"><h2 class=\"bde-heading-1164-103 bde-heading\">\nThank You.\n</h2><h2 class=\"bde-heading-1164-107 bde-heading\">\nWe have sent the NFT Brochure download link to your email.\n</h2><h2 class=\"bde-heading-1164-106 bde-heading\">\n Please click the same to download the brochure.\n</h2><h3 class=\"bde-heading-1164-104 bde-heading\">\nPlease call +91 -  97312 07940 for appointment with Our Senior Hair Transplant Surgeon - Dr Sandeep Mahapatra.\n</h3><div class=\"bde-button-1164-105 bde-button\">\n        \n    \n    \n    \n    \n            \n                    \n            \n            \n\n    \n    \n    \n    \n    \n    <a class=\"breakdance-link button-atom button-atom--primary bde-button__button\" href=\"tel:+919731207940\" target=\"_self\" data-type=\"url\"  >\n\n    \n        <span class=\"button-atom__text\">Call #  +91 97312 07940</span>\n\n        \n        \n                </a>\n\n    \n\n\n</div></div>\n</section>",
  "protected": false
 },
 "excerpt": {
