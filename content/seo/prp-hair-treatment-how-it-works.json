              "@type": "Question",
              "name": "Is PRP hair treatment painful?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Most people tolerate it well, though injections can cause brief discomfort. A numbing cream may be used."
              }
            },
            {
              "@type": "Question",
              "name": "How many sessions are needed?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "It varies. Your doctor will suggest a plan after examining your scalp and may review it as you progress."
              }
            },
            {
              "@type": "Question",
              "name": "Can PRP regrow hair on a bald scalp?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "It is unlikely to where follicles are inactive. PRP is better suited to thinning hair than to completely bald areas."
              }
            },
            {
              "@type": "Question",
              "name": "Is PRP the same as GFC?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "They are related but not identical. Both use your own blood, but they are prepared differently. The right choice depends on your diagnosis."
              }
            },
            {
              "@type": "Question",
              "name": "Are there side effects?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Mild redness, tenderness or bruising can occur and usually settle soon. Tell your doctor about your medicines, blood conditions or scalp infections beforehand."
              }
            }
