          "mainEntity": [
            {
              "@type": "Question",
              "name": "Is hair transplant cost charged per graft or per session?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "It varies by clinic. Some quote per graft and others quote a package for a session. Ask for the method in writing, along with a list of what is included."
              }
            },
            {
              "@type": "Question",
              "name": "Does the technique change the cost?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "It can. Different techniques need different equipment, time and team effort. Your doctor should explain why a method suits your case, not only what it costs."
              }
            },
            {
              "@type": "Question",
              "name": "Can I know the exact cost without a consultation?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Online tools and phone quotes give a rough idea, but the graft count depends on examining your scalp and your donor area in person."
              }
            },
            {
              "@type": "Question",
              "name": "Are there costs beyond the procedure itself?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Possibly. Ask whether the consultation, medicines, dressings and follow-up visits are included, and whether a later session would be charged separately."
              }
            },
            {
              "@type": "Question",
              "name": "Is the lowest quote the one to choose?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Price alone is a poor guide. Compare the doctor's qualifications, how clearly the plan is explained and what the quote covers before you decide."
              }
            }
          ]
