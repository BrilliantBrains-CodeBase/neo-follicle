          "mainEntity": [
            {
              "@type": "Question",
              "name": "Is DHI better than FUE?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Not in every case. Each has its place, and the right choice depends on your hair loss, your donor hair and the surgeon's experience."
              }
            },
            {
              "@type": "Question",
              "name": "Is a DHI hair transplant painful?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Local anaesthesia numbs the area, so most people feel pressure rather than sharp pain. Some soreness afterwards is common and can be managed."
              }
            },
            {
              "@type": "Question",
              "name": "Do I need to shave my head for DHI?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The donor area is usually trimmed, but how much depends on the plan and technique. Ask what applies to you."
              }
            },
            {
              "@type": "Question",
              "name": "How long until I see results?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Growth usually begins after a few months and keeps building. Final results are generally judged after about a year."
              }
            },
            {
              "@type": "Question",
              "name": "Can a hair transplant fail?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Poor growth or complications can occur. That is why careful planning and a qualified, registered surgeon matter, along with following the aftercare advice."
              }
            }
          ]
