{
  "name": "neofollicle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:seo": "node scripts/gen-seo.mjs",
    "gen:og": "node scripts/gen-og-images.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "mirror:wp": "node scripts/mirror-wp-assets.mjs",
    "gen:pages": "node scripts/gen-pages.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "verify": "node scripts/verify-seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:blogimg": "node scripts/gen-blog-images.mjs",
    "gen:posts": "node scripts/gen-posts.mjs",
    "verify:posts": "node scripts/verify-posts.mjs",
    "gen:treatmentimg": "node scripts/gen-treatment-images.mjs",
    "verify:treatments": "node scripts/verify-treatments.mjs",
    "shoot": "node scripts/shoot.mjs",
    "gen:galleryimg": "node scripts/gen-gallery-images.mjs",
    "gen:videogallery": "node scripts/gen-video-gallery.mjs",
    "verify:gallery": "node scripts/verify-gallery.mjs",
    "gen:mediaimg": "node scripts/gen-media-images.mjs",
    "verify:media": "node scripts/verify-media.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "node-html-parser": "^9.0.4",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
