    "mainEntity": [
     {
      "@type": "Question",
      "name": "Is a beard transplant permanent?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Transplanted hair usually keeps the traits of the donor area, and many people have long-lasting results. Outcomes still vary, so ask the doctor what to expect in your case."
      }
     },
     {
      "@type": "Question",
      "name": "When can I shave after a beard transplant?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Your doctor will advise. Shaving is usually delayed until the grafts have settled."
      }
     },
     {
      "@type": "Question",
      "name": "Will a beard transplant look natural?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Natural-looking results depend on planning the direction, angle and density of the grafts. Careful design helps, but no outcome can be guaranteed."
      }
     },
     {
      "@type": "Question",
      "name": "Can a beard transplant cover scars?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "It can be considered for scarred areas if the skin is suitable. The doctor will assess whether grafts are likely to grow there."
      }
     },
     {
      "@type": "Question",
      "name": "Are there other options for a patchy beard?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Yes, depending on the cause. Medical treatment, treatment of an infection or watchful waiting may be advised. A diagnosis comes first."
      }
     }
    ]
