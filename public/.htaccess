# Apache config for static hosting (cPanel, Hostinger and similar).
# Every route is a prerendered folder/index.html, so no SPA rewrite is needed.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Retired WordPress pages (README "Deliberate deviations", item 4).
  RewriteRule ^sample-page/?$ / [R=301,L]
  RewriteRule ^maintenance-page/?$ / [R=301,L]
  RewriteRule ^category/uncategorized/?$ /our-blogs/ [R=301,L]
</IfModule>

# Hashed build assets never change; everything else revalidates.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
